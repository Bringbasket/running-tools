RUNNING_API_KEY=change-me-to-a-long-random-secret
RUNNING_ADDR=:8000
RUNNING_DATA_DIR=/data
RUNNING_REPOSITORY_URL=https://github.com/Bringbasket/running-tools
RUNNING_IMAGE=ghcr.io/bringbasket/running-tools:latest
RUNNING_HOST_PORT=8091

# Mail module
MAIL_CONFIG_PATH=/data/mail/hme-config.json
MAIL_STATE_DIR=/data/mail/state
MAIL_AUTO_REFRESH_INTERVAL=600

# Optional IMAP inbox (server-side only; never return the password to Vue)
HME_IMAP_USERNAME=
HME_IMAP_PASSWORD_FILE=
HME_IMAP_HOST=imap.gmail.com
HME_IMAP_PORT=993
HME_IMAP_MAILBOX=INBOX
HME_MAIL_SYNC_ENABLED=false
HME_MAIL_SYNC_POLL_SECONDS=120
HME_IMAP_LOOKBACK_DAYS=90
HME_IMAP_CACHE_MAX_MESSAGES=5000
