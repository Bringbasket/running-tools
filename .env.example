RUNNING_API_KEY=change-me-to-a-long-random-secret
RUNNING_ADDR=:8000
RUNNING_DATA_DIR=/data
RUNNING_REPOSITORY_URL=https://github.com/Bringbasket/running-tools
RUNNING_IMAGE=ghcr.io/bringbasket/running-tools:latest
RUNNING_HOST_PORT=8091

# PostgreSQL 15+ 与 Redis 7+
# Compose 默认使用 dual：JSON 为主读，同时写入 PostgreSQL。确认无误后改为 postgres。
# 本地不启动数据库时设置为 json，或不设置该变量直接运行 Go 服务。
RUNNING_STORAGE_MODE=dual
RUNNING_POSTGRES_DB=running_tools
RUNNING_POSTGRES_USER=running_tools
RUNNING_POSTGRES_PASSWORD=change-me-to-a-long-random-database-password
# 非 Compose 部署可以设置完整 RUNNING_DATABASE_URL；设置后优先于上面的拆分变量。
# RUNNING_DATABASE_URL=postgres://running_tools:password@127.0.0.1:5432/running_tools?sslmode=disable
RUNNING_REDIS_PASSWORD=change-me-to-a-long-random-redis-password
RUNNING_DATABASE_MAX_OPEN_CONNS=20
RUNNING_DATABASE_MAX_IDLE_CONNS=5
RUNNING_REDIS_PREFIX=running-tools:
RUNNING_REDIS_LOCK_TTL_SECONDS=600

# Mail module
MAIL_CONFIG_PATH=/data/mail/hme-config.json
MAIL_STATE_DIR=/data/mail/state
MAIL_AUTO_REFRESH_INTERVAL=600

# 可选 IMAP 默认值；在收件箱页面保存设置前使用。
# 密码不会返回给 Vue，生产环境建议挂载 Secret 文件。
HME_IMAP_USERNAME=
HME_IMAP_PASSWORD_FILE=
HME_IMAP_HOST=imap.gmail.com
HME_IMAP_PORT=993
HME_IMAP_MAILBOX=INBOX
HME_MAIL_SYNC_ENABLED=false
HME_MAIL_SYNC_POLL_SECONDS=120
HME_IMAP_LOOKBACK_DAYS=90
HME_IMAP_CACHE_MAX_MESSAGES=5000
